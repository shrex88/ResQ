# ResQAI Command Centre Email Notification Credentials Configuration
# Copy this file to .env in the backend directory to configure real email sending to shreyasbpalan5@gmail.com

COMMAND_CENTER_EMAIL=shreyasbpalan5@gmail.com
ALERT_EMAIL_TO=shreyasbpalan5@gmail.com

# OPTION 1: Gmail SMTP Configuration (Recommended)
# Create a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password

# OPTION 2: Resend HTTP API (Alternative)
# Get a free API key at https://resend.com
# RESEND_API_KEY=re_123456789...

# OPTION 3: SendGrid HTTP API (Alternative)
# Get an API key at https://sendgrid.com
# SENDGRID_API_KEY=SG.123456789...

# OPTION 4: Webhook / HTTP Email Relay Service
# EMAIL_WEBHOOK_URL=https://formspree.io/f/your_form_id
